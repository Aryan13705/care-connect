{
  "expo": {
    "name": "CareConnect Patient",
    "slug": "careconnect-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "careconnect-patient",
    "splash": {
      "backgroundColor": "#FAFBF8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.careconnect.patient"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAFBF8"
      },
      "package": "com.careconnect.patient"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
